{
  "openapi": "3.0.1",
  "info": {
    "title": "AuthorizationAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/Authorize": {
      "post": {
        "tags": [
          "Authorize"
        ],
        "parameters": [
          {
            "name": "password",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Authorize/RefreshJwt": {
      "post": {
        "tags": [
          "Authorize"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmployeeTable": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "employeeId": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "employeeType": {
            "type": "string",
            "nullable": true
          },
          "userType": {
            "type": "string",
            "nullable": true
          },
          "group": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "employeeEmail": {
            "type": "string",
            "nullable": true
          },
          "traveling": {
            "type": "boolean"
          },
          "invertedWeek": {
            "type": "boolean"
          },
          "leader": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "reportsTo": {
            "type": "integer",
            "format": "int32"
          },
          "assignedTo": {
            "type": "string",
            "nullable": true
          },
          "deptId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "team": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/EmployeeTable"
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          },
          "accessToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}